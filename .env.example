# Kopier til .env, eller kør scripts/generate-env.sh

# Adresser i Caddy
# Produktion:
#   SITE_ADDRESS=feriehus1983.dk
#   ADMIN_ADDRESS=admin.feriehus1983.dk
#   CMS_PUBLIC_URL=https://admin.feriehus1983.dk
SITE_ADDRESS=http://localhost
ADMIN_ADDRESS=http://admin.localhost
CMS_PUBLIC_URL=http://admin.localhost

# Hjemmesidens fulde adresse, bruges af preview (produktion: https://feriehus1983.dk)
SITE_URL=http://localhost

# Strapi-hemmeligheder (genereres af scripts/generate-env.sh)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
# Hemmelig nøgle, der beskytter forhåndsvisning af kladder (genereres af scriptet)
PREVIEW_SECRET=

# API-token med kun læseadgang, oprettes i Strapi-admin (se README)
STRAPI_TOKEN=
