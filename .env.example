# Copy to .env, or run scripts/generate-env.sh

# Addresses in Caddy
# Production:
#   SITE_ADDRESS=feriehus1983.dk
#   ADMIN_ADDRESS=admin.feriehus1983.dk
#   CMS_PUBLIC_URL=https://admin.feriehus1983.dk
SITE_ADDRESS=http://localhost
ADMIN_ADDRESS=http://admin.localhost
CMS_PUBLIC_URL=http://admin.localhost

# The site's full URL, used by preview (production: https://feriehus1983.dk)
SITE_URL=http://localhost

# Strapi secrets (generated by scripts/generate-env.sh)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
# Secret that protects draft previews (generated by the script)
PREVIEW_SECRET=

# Read-only API token, created in the Strapi admin (see README)
STRAPI_TOKEN=
