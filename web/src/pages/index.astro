---
import Layout from '../layouts/Layout.astro';
import ArticleView from '../components/Article.astro';
import NewsList from '../components/NewsList.astro';
import { getLatestArticle } from '../lib/strapi';
import { readPageNumber } from '../lib/pagination';

const page = readPageNumber(Astro.url);
if (page === null) return Astro.rewrite('/404');

let latest = null;
let failed = false;
try {
  latest = await getLatestArticle();
} catch (e) {
  console.error(e);
  failed = true;
  Astro.response.status = 503;
}
---

<Layout view="list">
  {latest && <ArticleView article={latest} headingLevel={2} />}
  {!latest && !failed && <p class="notice">Der er ingen nyheder endnu.</p>}
  {failed && <p class="notice">Siden kunne ikke hente indhold lige nu. Prøv igen om lidt.</p>}
  <NewsList slot="aside" page={page} activeSlug={latest?.slug} headingLevel={1} pageWithArticle={false} />
</Layout>
