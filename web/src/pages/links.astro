---
import Layout from '../layouts/Layout.astro';
import NewsList from '../components/NewsList.astro';
import { getLinks, type Link } from '../lib/strapi';

let links: Link[] | null = null;
try {
  links = await getLinks();
} catch (e) {
  console.error(e);
  Astro.response.status = 503;
}
---

<Layout title="Nyttige links">
  <h1>Nyttige links</h1>
  {!links && <p class="notice">Linkene kunne ikke hentes lige nu. Prøv igen om lidt.</p>}
  {links && links.length === 0 && <p class="notice">Der er ingen links endnu.</p>}
  {
    links && links.length > 0 && (
      <ul class="link-list">
        {links.map((link) => (
          <li>
            <a href={link.url} rel="noopener noreferrer">{link.title}</a>
            {link.description && <p>{link.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
  <NewsList slot="aside" page={1} />
</Layout>
