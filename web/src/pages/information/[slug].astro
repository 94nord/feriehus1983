---
import Layout from '../../layouts/Layout.astro';
import Blocks from '../../components/Blocks.astro';
import NewsList from '../../components/NewsList.astro';
import { getPage } from '../../lib/strapi';

const { slug = '' } = Astro.params;

let page;
try {
  page = await getPage(slug);
} catch (e) {
  console.error(e);
  Astro.response.status = 503;
}
if (page === null) return Astro.rewrite('/404');
---

<Layout title={page?.title}>
  <p class="back-link"><a href="/information"><span aria-hidden="true">←&nbsp;</span>Information</a></p>
  {
    page && (
      <article class="article">
        <h1>{page.title}</h1>
        {page.body && <Blocks blocks={page.body} />}
      </article>
    )
  }
  {!page && <p class="notice">Siden kunne ikke hentes lige nu. Prøv igen om lidt.</p>}
  <NewsList slot="aside" page={1} />
</Layout>
