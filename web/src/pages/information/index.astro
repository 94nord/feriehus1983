---
import Layout from '../../layouts/Layout.astro';
import NewsList from '../../components/NewsList.astro';
import { getPages, type Page } from '../../lib/strapi';

let pages: Page[] | null = null;
try {
  pages = await getPages();
} catch (e) {
  console.error(e);
  Astro.response.status = 503;
}
---

<Layout title="Information">
  <h1>Information</h1>
  {!pages && <p class="notice">Siderne kunne ikke hentes lige nu. Prøv igen om lidt.</p>}
  {pages && pages.length === 0 && <p class="notice">Der er ingen sider endnu.</p>}
  {
    pages && pages.length > 0 && (
      <ul class="page-list">
        {pages.map((page) => (
          <li>
            <a href={`/information/${page.slug}`}>{page.title}</a>
          </li>
        ))}
      </ul>
    )
  }
  <NewsList slot="aside" page={1} />
</Layout>
