---
import Layout from '../../layouts/Layout.astro';
import ArticleView from '../../components/Article.astro';
import NewsList from '../../components/NewsList.astro';
import { getArticle } from '../../lib/strapi';
import { readPageNumber } from '../../lib/pagination';

const { slug = '' } = Astro.params;
const page = readPageNumber(Astro.url);
if (page === null) return Astro.rewrite('/404');

let article;
try {
  article = await getArticle(slug);
} catch (e) {
  console.error(e);
  Astro.response.status = 503;
}
if (article === null) return Astro.rewrite('/404');
---

<Layout title={article?.title} description={article?.excerpt ?? undefined}>
  <p class="back-link mobile-only">
    <a href={page > 1 ? `/?side=${page}` : '/'}><span aria-hidden="true">←&nbsp;</span>Alle nyheder</a>
  </p>
  {article && <ArticleView article={article} />}
  {!article && <p class="notice">Nyheden kunne ikke hentes lige nu. Prøv igen om lidt.</p>}
  <NewsList slot="aside" page={page} activeSlug={slug} />
</Layout>
