---
import { formaterDato, hentNyheder } from '../lib/strapi';

interface Props {
  side: number;
  aktivSlug?: string;
}

const { side, aktivSlug } = Astro.props;

let resultat: Awaited<ReturnType<typeof hentNyheder>> | null = null;
try {
  resultat = await hentNyheder(side);
} catch (fejl) {
  console.error(fejl);
}

const sideParam = (n: number) => (n > 1 ? `?side=${n}` : '');
// Bladring bevarer den nyhed, der er åben
const sideHref = (n: number) => `${aktivSlug ? `/nyheder/${aktivSlug}` : '/'}${sideParam(n)}`;
---

<nav class="nyhedsliste" aria-label="Nyheder">
  <h2>Nyheder</h2>
  {!resultat && <p class="besked">Nyhederne kunne ikke hentes lige nu.</p>}
  {resultat && resultat.nyheder.length === 0 && side === 1 && <p class="besked">Der er ingen nyheder endnu.</p>}
  {
    resultat && resultat.nyheder.length === 0 && side > 1 && (
      <p class="besked">
        Der er ikke flere nyheder. <a href={sideHref(1)}>Gå til første side</a>.
      </p>
    )
  }
  {
    resultat && resultat.nyheder.length > 0 && (
      <ol>
        {resultat.nyheder.map((nyhed) => (
          <li>
            <a
              href={`/nyheder/${nyhed.slug}${sideParam(side)}`}
              aria-current={nyhed.slug === aktivSlug ? 'page' : undefined}
            >
              <span class="nyhedsliste-titel">{nyhed.titel}</span>
              <time datetime={nyhed.publishedAt}>{formaterDato(nyhed.publishedAt)}</time>
              <span class="nyhedsliste-uddrag">{nyhed.uddrag}</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  {
    resultat && resultat.antalSider > 1 && (
      <div class="pagination">
        {side > 1 ? <a href={sideHref(side - 1)}><span aria-hidden="true">←&nbsp;</span>Forrige</a> : <span />}
        <span class="pagination-status">Side {side} af {resultat.antalSider}</span>
        {side < resultat.antalSider ? <a href={sideHref(side + 1)}>Næste<span aria-hidden="true">&nbsp;→</span></a> : <span />}
      </div>
    )
  }
</nav>
