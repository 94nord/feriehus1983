---
import type { Nyhed } from '../lib/strapi';
import { billedeSrcset, formaterDato, medieUrl } from '../lib/strapi';
import Blocks from './Blocks.astro';

interface Props {
  nyhed: Nyhed;
}

const { nyhed } = Astro.props;
---

<article class="artikel">
  <header>
    <h1>{nyhed.titel}</h1>
    <time datetime={nyhed.publishedAt}>{formaterDato(nyhed.publishedAt)}</time>
  </header>
  {
    nyhed.billede && (
      <figure class="artikel-billede">
        <img
          src={medieUrl(nyhed.billede.url)}
          srcset={billedeSrcset(nyhed.billede)}
          sizes="(max-width: 768px) 100vw, 60vw"
          width={nyhed.billede.width}
          height={nyhed.billede.height}
          alt={nyhed.billede.alternativeText ?? ''}
        />
      </figure>
    )
  }
  {nyhed.indhold && <Blocks blocks={nyhed.indhold} />}
</article>
