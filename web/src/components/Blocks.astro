---
import type { Block, ListElement } from '../lib/strapi';
import { inlineToHtml } from '../lib/inline';
import { imageSrc, imageSrcset } from '../lib/strapi';

interface Props {
  blocks: (Block | ListElement)[];
}

const { blocks } = Astro.props;
---

{
  blocks.map((block) => {
    switch (block.type) {
      case 'paragraph':
        return <p set:html={inlineToHtml(block.children)} />;
      case 'heading': {
        // h1 is reserved for the page title, so headings in the body start at h2
        const Tag = `h${Math.max(2, Math.min(block.level + 1, 6))}`;
        return <Tag set:html={inlineToHtml(block.children)} />;
      }
      case 'quote':
        return <blockquote set:html={inlineToHtml(block.children)} />;
      case 'code':
        return <pre><code set:html={inlineToHtml(block.children)} /></pre>;
      case 'list': {
        const Tag = block.format === 'ordered' ? 'ol' : 'ul';
        return (
          <Tag>
            {block.children.map((element) =>
              element.type === 'list-item' ? (
                <li set:html={inlineToHtml(element.children)} />
              ) : (
                <li><Astro.self blocks={[element]} /></li>
              )
            )}
          </Tag>
        );
      }
      case 'image':
        return (
          <figure class="body-image">
            <img
              src={imageSrc(block.image)}
              srcset={imageSrcset(block.image)}
              sizes="(max-width: 768px) 100vw, 32rem"
              width={block.image.width}
              height={block.image.height}
              alt={block.image.alternativeText ?? ''}
              loading="lazy"
            />
          </figure>
        );
      default:
        return null;
    }
  })
}
