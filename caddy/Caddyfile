# The addresses come from .env:
#   production: feriehus1983.dk and admin.feriehus1983.dk (automatic HTTPS)
#   local:      http://localhost and http://admin.localhost

{$SITE_ADDRESS} {
	encode zstd gzip

	# Images from Strapi's media library
	handle /uploads/* {
		reverse_proxy cms:1337
	}

	handle {
		reverse_proxy web:4321
	}
}

{$ADMIN_ADDRESS} {
	encode zstd gzip

	request_body {
		max_size 20MB
	}

	# End-user login and registration are not used
	@end_user_auth path /api/auth/* /api/users /api/users/* /api/connect/*
	respond @end_user_auth 404

	# Password reset needs email, which is not set up; a Super Admin sets new passwords
	@password_reset path /admin/forgot-password /admin/reset-password
	respond @password_reset 404

	redir / /admin
	reverse_proxy cms:1337
}
